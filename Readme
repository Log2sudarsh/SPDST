
import { Injectable, signal } from '@angular/core';
import { HttpClient } from '@angular/common/http';

export interface DbgList {
  Launchid: number;
  TstRefNo: number;
  FirmwareNm: string;
  Loc: string;
  Type: string;
  Mplan: string;
  LaunchType: string;
  count1: number;
  count2: number;
  count3: number;
}

@Injectable({
  providedIn: 'root'
})
export class DbgListService {
  private apiUrl = 'https://your-api-endpoint/dbglist'; // Replace with actual API

  dbgList = signal<DbgList[]>([]);

  constructor(private http: HttpClient) {}

  fetchDbgList(): void {
    this.http.get<DbgList[]>(this.apiUrl).subscribe((data) => {
      this.dbgList.set(data);
    });
  }
}


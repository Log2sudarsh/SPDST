
import { Injectable, signal } from '@angular/core';
import { HttpClient } from '@angular/common/http';

export interface ProjectMetaData {
  projectName: string;
  autId: number;
  url?: string;
  sourceType?: string;
  tstRef?: string;
}

@Injectable({
  providedIn: 'root'
})
export class ProjectMetaDataService {
  private apiUrl = 'https://your-api-endpoint/projectmetadata';  // Replace with actual API

  projectMetaData = signal<ProjectMetaData | null>(null);

  constructor(private http: HttpClient) {}

  fetchProjectMetaData(): void {
    this.http.get<ProjectMetaData>(this.apiUrl).subscribe((data) => {
      this.projectMetaData.set(data);
    });
  }
}

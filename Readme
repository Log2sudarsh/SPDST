
.custom-select {
  width: 250px !important; /* Adjust width */
  height: 40px !important; /* Adjust height */
  margin-right: 16px; /* Add spacing */
}

::ng-deep .mat-select-trigger {
  min-height: 40px !important;
  font-size: 14px !important;
}

<mat-form-field appearance="outline" class="custom-select">
  <mat-label>Select Project</mat-label>
  <mat-select [(ngModel)]="selectedProject" (selectionChange)="onProjectChange($event.value)">
    <mat-option *ngFor="let project of projects" [value]="project">
      {{ project.projectName }}
    </mat-option>
  </mat-select>
</mat-form-field>

selectedProject!: Project;
projects: Project[] = [];

constructor(private projectService: ProjectService) {}

ngOnInit(): void {
  this.projectService.getProjects().subscribe((data) => {
    this.projects = data;

    // Set first project as default selected
    if (this.projects.length > 0) {
      this.selectedProject = this.projects[0];
      this.onProjectChange(this.selectedProject);
    }
  });
}

onProjectChange(project: Project): void {
  console.log('Selected Project:', project);
  // Handle project change logic (e.g., update API request body)
}





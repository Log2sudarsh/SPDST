
import { Injectable, inject, Signal, signal } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Observable } from 'rxjs';
import { resource, rxResource } from '@angular/core/rxjs-interop';

interface ProjectMetaData {
  PId: number;
  Pname: string;
  PgName: string;
  Url: string;
}

interface DbgViewList {
  Lid: number;
  RefRef: number;
  Fname: string;
  Loc: string;
  Count1: number;
  Count2: number;
  Count3: number;
  Count4: number;
  SLibk: string;
}

@Injectable({
  providedIn: 'root',
})
export class DbgViewService {
  private http = inject(HttpClient);
  private headers = new HttpHeaders({ 'Content-Type': 'application/json' });

  // ✅ Fetch Project Metadata (Dropdown Data)
  getProjectMetaData(): Observable<ProjectMetaData[]> {
    return this.http.get<ProjectMetaData[]>('https://api.example.com/project-metadata');
  }

  // ✅ Fetch Debug View List based on Project ID
  getDbgViewList(projectId: number): Observable<DbgViewList[]> {
    return this.http.get<DbgViewList[]>(`https://api.example.com/dbg-view/${projectId}`);
  }

  // ✅ Signal for selected project (reactive binding)
  selectedProjectId = signal<number | null>(null);

  // ✅ Project Metadata List (for dropdown)
  metaDataList$ = rxResource<ProjectMetaData[], unknown>(() => this.getProjectMetaData());

  // ✅ Debug View List (updates when selectedProjectId changes)
  dbgListData = resource<DbgViewList[], number>({
    request: this.selectedProjectId,
    loader: (id) => this.getDbgViewList(id),
    loaderInitialValue: [],
  });

  // ✅ Method to update selected project ID (Triggers DebugView API)
  updateProjectId(newId: number) {
    this.selectedProjectId.set(newId);
  }
}


import { Injectable, inject, signal } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { rxResource } from '@angular/core/rxjs-interop';
import { dbgViewList, dbgViewListRequestPayload } from './models';

@Injectable({
  providedIn: 'root',
})
export class DbgViewService {
  private headers = new HttpHeaders({ 'Content-Type': 'application/json' });

  private http = inject(HttpClient);

  // Using rxResource with request & loader
  dbgViewResource = rxResource<dbgViewList[], dbgViewListRequestPayload>({
    request: signal<dbgViewListRequestPayload | null>(null), // Stores the current request payload
    loader: (payload) =>
      this.http.post<dbgViewList[]>('api/dbg-view/run', payload, { headers: this.headers }),
  });

  // Function to trigger API call
  getDbgViewList(payload: dbgViewListRequestPayload) {
    this.dbgViewResource.update(payload); // This updates the request and triggers the loader
  }
}


import { Component, OnInit } from '@angular/core';
import { Observable, BehaviorSubject } from 'rxjs';
import { ProjectService } from '../services/project.service';
import { Project } from '../models/project.model';
import { tap } from 'rxjs/operators';

@Component({
  selector: 'app-milestone-list',
  templateUrl: './milestone-list.component.html',
  styleUrls: ['./milestone-list.component.css'],
})
export class MilestoneListComponent implements OnInit {
  projects$!: Observable<Project[]>; // Observable for project data
  selectedProject!: Project; // Stores the selected project
  private projectSubject = new BehaviorSubject<Project | null>(null); // BehaviorSubject for default selection
  selectedProject$ = this.projectSubject.asObservable(); // Observable for selected project

  constructor(private projectService: ProjectService) {}

  ngOnInit(): void {
    this.projects$ = this.projectService.getProjects().pipe(
      tap((projects) => {
        if (projects.length > 0) {
          this.projectSubject.next(projects[0]); // Set first project as default
        }
      })
    );
  }

  onProjectChange(project: Project): void {
    this.projectSubject.next(project); // Update selected project
    console.log('Selected Project:', project);
  }
}



<mat-form-field appearance="outline" class="custom-select">
  <mat-label>Select Project</mat-label>
  <mat-select [value]="(selectedProject$ | async)" (selectionChange)="onProjectChange($event.value)">
    <mat-option *ngFor="let project of (projects$ | async)" [value]="project">
      {{ project.projectName }}
    </mat-option>
  </mat-select>
</mat-form-field>


.custom-select {
  width: 250px !important;
  height: 40px !important;
  margin-right: 16px;
}

::ng-deep .mat-select-trigger {
  min-height: 40px !important;
  font-size: 14px !important;
}




import { Injectable, inject, signal } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { rxResource } from '@angular/core/rxjs-interop';
import { Observable } from 'rxjs';

interface DbgViewListRequestPayload {
  DBProject: string;
  ProgramNm: string;
  ValidationTypeNm: string;
}

interface DbgViewList {
  Lid: number;
  RefRef: number;
  Fname: string;
  Loc: string;
  Count1: number;
  Count2: number;
  Count3: number;
  Count4: number;
  SLibk: string;
}

interface ProjectMetaData {
  PId: number;
  Pname: string;
  PgName: string;
  Url: string;
}

@Injectable({
  providedIn: 'root',
})
export class DbgViewService {
  private http = inject(HttpClient);
  private headers = new HttpHeaders({ 'Content-Type': 'application/json' });

  getDbgViewList(requestPayload: DbgViewListRequestPayload): Observable<DbgViewList[]> {
    const url = `api/dbg-view/run`;
    return this.http.post<DbgViewList[]>(url, requestPayload, { headers: this.headers });
  }

  getProjectMetaData(): Observable<ProjectMetaData[]> {
    const url = `api/project-metadata`;
    return this.http.get<ProjectMetaData[]>(url);
  }
}

======

import { Component, inject, OnInit, signal } from '@angular/core';
import { DbgViewService } from './dbg-view.service';
import { resource, rxResource } from '@angular/core/rxjs-interop';

interface ProjectMetaData {
  PId: number;
  Pname: string;
  PgName: string;
  Url: string;
}

interface DbgViewList {
  Lid: number;
  RefRef: number;
  Fname: string;
  Loc: string;
  Count1: number;
  Count2: number;
  Count3: number;
  Count4: number;
  SLibk: string;
}

@Component({
  selector: 'app-dbg-view',
  templateUrl: './dbg-view.component.html',
  styleUrls: ['./dbg-view.component.css'],
})
export class DbgViewComponent implements OnInit {
  private dbgViewService = inject(DbgViewService);

  // Signals
  metaDataList$ = rxResource(() => this.dbgViewService.getProjectMetaData());
  selectedMetaProject = signal<ProjectMetaData | null>(null);
  
  // Resource for DbgViewList with a request & loader
  dbgListData = resource(
    (metaData) => this.dbgViewService.getDbgViewList(metaData), 
    { request: this.selectedMetaProject, loader: [] }
  );

  ngOnInit() {
    this.metaDataList$.subscribe((metadataProjects) => {
      if (metadataProjects.length > 0) {
        this.selectedMetaProject.set(metadataProjects[0]);
      }
    });
  }

  onProjectSelect(metaData: ProjectMetaData) {
    this.selectedMetaProject.set(metaData);
  }
}

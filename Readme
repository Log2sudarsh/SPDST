import { Injectable, inject } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';
import { Milestone } from '../models/milestone.model';

@Injectable({
  providedIn: 'root',
})
export class MilestoneService {
  private http = inject(HttpClient);
  private apiUrl = 'https://api.example.com/milestones';

  getMilestones(requestBody: any): Observable<Milestone[]> {
    return this.http.post<Milestone[]>(this.apiUrl, requestBody); // No token or extra headers
  }
}

_______

@Injectable({
  providedIn: 'root',
})
export class AuthService implements HttpInterceptor {
  private http = inject(HttpClient);
  private tokenUrl = 'https://api.example.com/get-token'; // Replace with actual token API
  private tokenSubject = new BehaviorSubject<string | null>(null);

  // **List of APIs that require authentication**
  private authRequiredApis = [
    'https://api.example.com/projects',
    'https://api.example.com/users',
    'https://api.example.com/tasks',
  ];

  constructor() {
    this.refreshTokenPeriodically();
  }

  // **Fetch new token**
  private fetchToken(): Observable<string> {
    return this.http.post<string>(this.tokenUrl, { username: 'user', password: 'pass' });
  }

  // **Automatically refresh token every 3 minutes**
  private refreshTokenPeriodically() {
    this.fetchToken().subscribe((token) => this.tokenSubject.next(token));

    timer(0, 180000) // Refresh every 3 minutes (180000 ms)
      .pipe(switchMap(() => this.fetchToken()))
      .subscribe((token) => this.tokenSubject.next(token));
  }

  // **Get the latest token**
  getToken(): Observable<string | null> {
    return this.tokenSubject.asObservable();
  }

  // **Interceptor: Apply token only for APIs in `authRequiredApis`**
  intercept(req: HttpRequest<any>, next: HttpHandler): Observable<HttpEvent<any>> {
    if (!this.authRequiredApis.some((api) => req.url.includes(api))) {
      return next.handle(req); // Skip modifying other APIs
    }

    return this.getToken().pipe(
      switchMap((token) => {
        if (!token) return next.handle(req); // Proceed if no token

        // Clone request & add Authorization + Custom Headers
        const authReq = req.clone({
          setHeaders: {
            Authorization: `Bearer ${token}`,
            'Custom-Header': 'SomeValue', // Modify as needed
          },
        });

        return next.handle(authReq);
      })
    );
  }
}


______
import { bootstrapApplication } from '@angular/platform-browser';
import { provideHttpClient, withInterceptors } from '@angular/common/http';
import { AppComponent } from './app/app.component';
import { AuthService } from './app/services/auth.service';

bootstrapApplication(AppComponent, {
  providers: [
    provideHttpClient(withInterceptors([AuthService])) // Register AuthService Interceptor
  ],
}).catch((err) => console.error(err));



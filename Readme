

import { Injectable, signal } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { resource, rxResource } from '@angular/core/rxjs-interop';
import { Observable } from 'rxjs';

import { ProjectMetaData, debugViewListRequestPayload, debugViewList } from '../models/debug-view.model';

@Injectable({
  providedIn: 'root',
})
export class DebugViewService {
  private apiBaseUrl = 'https://your-api-endpoint.com'; // Replace with your actual API base URL

  // Signal to store API responses
  projectMetadataSignal = signal<ProjectMetaData | null>(null);
  debugViewListSignal = signal<debugViewList[]>([]);

  // Fetch Project Metadata (GET API)
  projectMetadata$ = rxResource<ProjectMetaData>(() =>
    this.http.get<ProjectMetaData>(`${this.apiBaseUrl}/project-metadata`)
  );

  // Fetch Debug View List (POST API)
  fetchDebugViewList(payload: debugViewListRequestPayload): Observable<debugViewList[]> {
    return this.http.post<debugViewList[]>(`${this.apiBaseUrl}/debug-view-list`, payload);
  }

  constructor(private http: HttpClient) {}

  loadProjectMetadata() {
    this.projectMetadata$.request(); // Trigger resource fetch
  }

  loadDebugViewList(payload: debugViewListRequestPayload) {
    this.fetchDebugViewList(payload).subscribe((data) => {
      this.debugViewListSignal.set(data);
    });
  }
}

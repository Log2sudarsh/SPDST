const express = require('express');
const multer = require('multer');
const axios = require('axios');
const cors = require('cors');
const FormData = require('form-data');

const app = express();
const port = 3000;

// Enable CORS
app.use(cors());

// Multer Configuration for File Upload (Store in Memory)
const storage = multer.memoryStorage();
const upload = multer({ storage });

// API Endpoint to Handle File Upload and Forward to .NET
app.post('/upload', upload.single('file'), async (req, res) => {
    try {
        if (!req.file) {
            return res.status(400).json({ message: 'No file uploaded' });
        }

        const uniqueRef = req.body.UniqueRef; // Get UniqueRef from request
        const fileBuffer = req.file.buffer; // Get file as binary buffer
        const fileName = req.file.originalname; // Get File Name

        // Prepare FormData
        const formData = new FormData();
        formData.append('UniqueRef', uniqueRef);
        formData.append('file', fileBuffer, fileName); // Send file as binary

        // Call .NET API
        const dotNetApiUrl = 'https://your-dotnet-api.com/upload'; // Replace with actual .NET API URL
        const response = await axios.post(dotNetApiUrl, formData, {
            headers: {
                ...formData.getHeaders(), // Set correct multipart headers
                'Accept': 'application/json'
            }
        });

        return res.status(200).json({ message: 'File uploaded successfully', data: response.data });
    } catch (error) {
        console.error('Upload Error:', error);
        return res.status(500).json({ message: 'File upload failed', error: error.message });
    }
});

app.listen(port, () => {
    console.log(`Node.js Server Running on http://localhost:${port}`);
});

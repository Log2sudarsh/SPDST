import { Component } from '@angular/core';
import { UploadService } from '../services/upload.service';

@Component({
  selector: 'app-upload',
  templateUrl: './upload.component.html',
  styleUrls: ['./upload.component.css']
})
export class UploadComponent {
  selectedFile: Blob | null = null; // Store converted file as Blob
  fileName: string = '';
  uniqueRef: string = '12345'; // Example UniqueRef (Replace dynamically)

  constructor(private uploadService: UploadService) {}

  // Convert Base64 to Blob
  private base64ToBlob(base64: string, mimeType: string): Blob {
    const byteCharacters = atob(base64);
    const byteNumbers = new Array(byteCharacters.length);
    for (let i = 0; i < byteCharacters.length; i++) {
      byteNumbers[i] = byteCharacters.charCodeAt(i);
    }
    const byteArray = new Uint8Array(byteNumbers);
    return new Blob([byteArray], { type: mimeType });
  }

  // Handle File Selection
  onFileSelected(event: any) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.readAsDataURL(file);

    reader.onload = () => {
      const base64String = (reader.result as string).split(',')[1]; // Remove "data:<type>;base64,"
      this.selectedFile = this.base64ToBlob(base64String, file.type);
      this.fileName = file.name;
      console.log('File selected:', this.fileName);
    };
  }

  // Upload File (Triggered by Upload Button)
  uploadFile() {
    if (!this.selectedFile) {
      console.error('No file selected.');
      return;
    }

    this.uploadService.uploadFile(this.selectedFile, this.fileName, this.uniqueRef)
      .subscribe(response => {
        console.log('Upload successful', response);
      }, error => {
        console.error('Upload failed', error);
      });
  }
}
